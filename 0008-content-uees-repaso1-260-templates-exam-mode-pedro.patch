+              variant="outline"
+              size="sm"
+              onClick={() => setTemaIds([])}
+            >
+              {t("exam.config.none")}
+            </Button>
+          </span>
+        </div>
+        <ul className="mt-3 grid gap-2 sm:grid-cols-2">
